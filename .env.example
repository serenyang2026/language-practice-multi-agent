# Copy this file to .env and fill in the values. Never commit .env.

# Which model to use:
#   anthropic = temporary, for testing locally before the Azure OpenAI resource exists
#   azure     = the target setup (from step 5 on)
LLM_PROVIDER=azure

# --- Anthropic (temporary) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Azure OpenAI (step 5) ---
# No API key here: the app signs in with Entra ID (your az login locally,
# the managed identity in Azure).
AZURE_OPENAI_ENDPOINT=https://aoai-serenyang-lab.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=chat-mini
AZURE_OPENAI_API_VERSION=2024-10-21
