# Copy this file to .env and fill in the values. Never commit .env.

# Which model to use:
#   anthropic = temporary, for testing locally before the Azure OpenAI resource exists
#   azure     = the target setup (from step 5 on)
LLM_PROVIDER=anthropic

# --- Anthropic (temporary) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Azure OpenAI (step 5) ---
# No API key here: the app signs in with Entra ID (your az login locally,
# the managed identity in Azure).
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=<api-version-from-the-deployment-page>
